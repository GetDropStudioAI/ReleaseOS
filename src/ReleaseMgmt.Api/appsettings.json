{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": { "Override": { "Microsoft.AspNetCore": "Warning" } }
  },
  "Display": {
    "TimeZone": "America/Chicago"
  },
  "Release": {
    "OnDemandOffsetDays": 7
  },
  "Templates": {
    "LockComplianceGates": true,
    "MilestonesMoveWithTarget": true,
    "ComplianceChangeNeedsGovernanceOfficer": true
  }
}
