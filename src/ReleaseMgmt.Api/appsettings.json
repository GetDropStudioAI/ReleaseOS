{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": { "Override": { "Microsoft.AspNetCore": "Warning" } }
  },
  "Display": {
    "TimeZone": "America/Chicago"
  },
  "Ai": {
    "Provider": "anthropic",
    "KillSwitch": false,
    "Models": { "Small": "claude-haiku-5-5", "Drafting": "" },
    "TimeoutSeconds": 30,
    "MaxRetries": 2
  },
  "Release": {
    "OnDemandOffsetDays": 7
  },
  "Templates": {
    "LockComplianceGates": true,
    "MilestonesMoveWithTarget": true,
    "ComplianceChangeNeedsGovernanceOfficer": true
  }
}
